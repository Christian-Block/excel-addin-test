{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES2017", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "./dist",
    "types": ["office-js", "custom-functions-runtime", "jest", "node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "e2e/**/*.ts"]
}
